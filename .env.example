# Сервер
PORT=3000
NODE_ENV=development

# База данных (если не задано — используется SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/privchat

# JWT (не используется сейчас, для будущего расширения)
JWT_SECRET=your_super_secret_key_change_this

# SSL (оставь пустым для Railway/Heroku — там SSL терминируется на прокси)
# SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain/privkey.pem
# SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain/fullchain.pem
