# Core
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=https://your-domain.com
ALLOW_GUEST=false

# Limits
MAX_JSON_MB=20
MAX_SOCKET_MB=20

# DB
# DATABASE_URL=postgresql://user:password@localhost:5432/privchat

# TURN (ephemeral)
TURN_SECRET=change_me_turn_secret
TURN_TTL_SEC=600
TURN_URLS=turn:turn.your-domain.com:3478?transport=udp,turns:turn.your-domain.com:5349?transport=tcp

# OTP reset
OTP_TTL_SEC=600
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SEC=60
OTP_PROVIDER=console
